diff --git a/packages/executor/test/services/MempoolService/payerKeys.test.ts b/packages/executor/test/services/MempoolService/payerKeys.test.ts
new file mode 100644
index 0000000..4c538a0
--- /dev/null
+++ b/packages/executor/test/services/MempoolService/payerKeys.test.ts
@@ -0,0 +1,179 @@
+import { describe, it, expect, vi } from "vitest";
+import { keccak256 } from "viem";
+import { FrameTransaction, FRAME_MODE, APPROVE_SCOPE } from "@skandha/types/lib/contracts/FrameTx.js";
+import { MempoolEntryStatus } from "@skandha/types/lib/executor";
+import { MempoolService } from "../../../src/services/MempoolService/service.js";
+import { ExecutorEventBus } from "../../../src/services/SubscriptionService.js";
+import { encodeRawFrameTx } from "../../../src/services/FrameTxService/codec.js";
+
+// Payer keys (Nainokot privacy pool experiment): at most one pending transaction per (payer, key),
+// whoever its sender is; another takes the keys over only with exactly the same keys and a 10%
+// fee bump. For a shielded privacy pool the keys are its notes' nullifier slots.
+
+const POOL = "0x9999999999999999999999999999999999999999" as const;
+const OTHER_POOL = "0x8888888888888888888888888888888888888888" as const;
+const sender = (i: number) => `0x${(i + 1).toString(16).padStart(40, "0")}` as `0x${string}`;
+const NF = (i: number) => `0x${(i + 1).toString(16).padStart(64, "0")}`;
+
+function memoryDb() {
+  const m = new Map<string, any>();
+  return {
+    get: async (k: string) => {
+      if (!m.has(k)) throw new Error("Not Found");
+      return m.get(k);
+    },
+    put: async (k: string, v: any) => {
+      m.set(k, v);
+    },
+    del: async (k: string) => {
+      m.delete(k);
+    },
+    getMany: async (ks: string[]) => ks.map((k) => m.get(k)).filter(Boolean),
+  } as any;
+}
+
+const build = () =>
+  new MempoolService(
+    memoryDb(),
+    1,
+    { updateIncludedStatus: vi.fn().mockResolvedValue(undefined) } as any,
+    new ExecutorEventBus(),
+    { useropsTTL: 300, archiveDuration: 1 } as any,
+    { debug: vi.fn(), error: vi.fn() } as any
+  );
+
+/** [only_verify(sender)] [pay(payer)] [SENDER call]: the user is the sender, the pool pays. */
+const sponsored = (from: `0x${string}`, fee = 10n, payer: `0x${string}` = POOL): FrameTransaction => ({
+  chainId: 1n,
+  nonceKeys: [0n],
+  nonceSeq: 0n,
+  sender: from,
+  frames: [
+    {
+      mode: FRAME_MODE.VERIFY,
+      flags: APPROVE_SCOPE.EXECUTION,
+      target: null,
+      limits: { execution: 30_000n, state: 0n },
+      value: 0n,
+      data: "0x",
+    },
+    {
+      mode: FRAME_MODE.VERIFY,
+      flags: APPROVE_SCOPE.PAYMENT,
+      target: payer,
+      limits: { execution: 300_000n, state: 0n },
+      value: 0n,
+      data: "0x",
+    },
+    {
+      mode: FRAME_MODE.SENDER,
+      flags: 0,
+      target: "0x7777777777777777777777777777777777777777",
+      limits: { execution: 50_000n, state: 0n },
+      value: 0n,
+      data: "0x",
+    },
+  ],
+  signatures: [],
+  fees: { maxPriorityFeePerGas: fee, maxFeePerGas: fee, maxFeePerBlobGas: 0n },
+  blobVersionedHashes: [],
+  recentRootReferences: [],
+});
+
+const hashOf = (t: FrameTransaction) => keccak256(encodeRawFrameTx(t));
+const add = (pool: MempoolService, t: FrameTransaction, keys: string[]) =>
+  pool.addFrameTx(t, hashOf(t), undefined, undefined, undefined, undefined, undefined, keys);
+const pending = async (pool: MempoolService) =>
+  (await pool.fetchPendingUserOps())
+    .filter((e) => e.status === MempoolEntryStatus.New)
+    .map((e) => e.txHash)
+    .sort();
+
+describe("MempoolService - payer keys (one pending tx per (payer, nullifier))", () => {
+  it("admits many sponsored txs of one pool that spend different notes", async () => {
+    const pool = build();
+    const txs = Array.from({ length: 10 }, (_, i) => sponsored(sender(i)));
+    for (const [i, t] of txs.entries()) {
+      expect((await add(pool, t, [NF(2 * i), NF(2 * i + 1)])).replacedTxHash).toBeUndefined();
+    }
+    expect(await pending(pool)).toEqual(txs.map(hashOf).sort());
+  });
+
+  it("refuses a second tx of the same pool and nullifier from another sender at the same fee", async () => {
+    const pool = build();
+    const first = sponsored(sender(0));
+    await add(pool, first, [NF(0), NF(1)]);
+    await expect(add(pool, sponsored(sender(1)), [NF(0), NF(1)])).rejects.toThrow(
+      new RegExp(`key ${NF(0)} is already held by pending transaction ${hashOf(first)}; to replace it, raise both fees`)
+    );
+    expect(await pending(pool)).toEqual([hashOf(first)]);
+  });
+
+  it("refuses a bump under 10%", async () => {
+    const pool = build();
+    await add(pool, sponsored(sender(0), 100n), [NF(0), NF(1)]);
+    await expect(add(pool, sponsored(sender(1), 109n), [NF(0), NF(1)])).rejects.toThrow(/raise both fees/);
+  });
+
+  it("lets the same nullifiers take over with a 10% fee bump, cancelling the old tx", async () => {
+    const pool = build();
+    const first = sponsored(sender(0), 100n);
+    await add(pool, first, [NF(0), NF(1)]);
+    const bumped = sponsored(sender(1), 110n);
+    expect((await add(pool, bumped, [NF(0), NF(1)])).replacedTxHash).toBe(hashOf(first));
+    expect(await pending(pool)).toEqual([hashOf(bumped)]);
+    const old = await pool.getEntryByHash(hashOf(first));
+    expect(old?.status).toBe(MempoolEntryStatus.Cancelled);
+    expect(old?.revertReason).toMatch(/replaced by .*same payer keys/);
+  });
+
+  it("refuses a partial overlap even with a higher fee", async () => {
+    const pool = build();
+    await add(pool, sponsored(sender(0), 100n), [NF(0), NF(1)]);
+    await expect(add(pool, sponsored(sender(1), 200n), [NF(1), NF(2)])).rejects.toThrow(
+      /a replacement must touch exactly the same payer keys/
+    );
+  });
+
+  it("refuses a tx that would take over two pending ones at once", async () => {
+    const pool = build();
+    await add(pool, sponsored(sender(0), 100n), [NF(0), NF(1)]);
+    await add(pool, sponsored(sender(1), 100n), [NF(2), NF(3)]);
+    await expect(add(pool, sponsored(sender(2), 200n), [NF(0), NF(1), NF(2), NF(3)])).rejects.toThrow(
+      /a replacement must touch exactly the same payer keys/
+    );
+    expect(await pending(pool)).toHaveLength(2);
+  });
+
+  it("keeps different payers apart: the same slot of another pool is no conflict", async () => {
+    const pool = build();
+    await add(pool, sponsored(sender(0)), [NF(0), NF(1)]);
+    await add(pool, sponsored(sender(1), 10n, OTHER_POOL), [NF(0), NF(1)]);
+    expect(await pending(pool)).toHaveLength(2);
+  });
+
+  it("frees the keys once the holder is no longer pending", async () => {
+    const pool = build();
+    const first = sponsored(sender(0));
+    await add(pool, first, [NF(0), NF(1)]);
+    const [entry] = await pool.fetchPendingUserOps();
+    await pool.updateStatus([entry], MempoolEntryStatus.Finalized);
+    await add(pool, sponsored(sender(1)), [NF(0), NF(1)]);
+    expect(await pending(pool)).toHaveLength(1);
+  });
+
+  it("does nothing for txs without payer keys (self-paying or unstaked payers)", async () => {
+    const pool = build();
+    await add(pool, sponsored(sender(0)), []);
+    await add(pool, sponsored(sender(1)), []);
+    expect(await pending(pool)).toHaveLength(2);
+  });
+
+  it("survives a round trip through storage", async () => {
+    const pool = build();
+    const first = sponsored(sender(0));
+    await add(pool, first, [NF(0), NF(1)]);
+    const [entry] = await pool.fetchPendingUserOps();
+    expect(entry.payerKeys).toEqual([NF(0), NF(1)]);
+  });
+});
