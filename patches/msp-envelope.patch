+/**
+ * The ERC-8421 alt mempool devnet (chain 1337) answers a simulation with canonicalMempoolValid
+ * and canonicalMempoolViolation instead of valid and violation; this fills in the two fields
+ * the rest of the client reads. An answer that has valid is returned as it is.
+ */
+function canonicalSimulation(result: unknown): unknown {
+  if (typeof result !== "object" || result === null || Array.isArray(result)) return result;
+  const r = result as Record<string, unknown>;
+  if (r.valid !== undefined || r.canonicalMempoolValid === undefined) return result;
+  return {
+    ...r,
+    valid: r.canonicalMempoolValid === true && r.executionStatus !== "failure",
+    violation: r.canonicalMempoolViolation ?? r.executionError ?? null,
+  };
+}
