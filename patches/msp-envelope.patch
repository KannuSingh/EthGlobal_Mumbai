+/** An EIP-8272 reference as the envelope declares it: RLP [source_id, slot, root]. */
+export interface RecentRootRef {
+  sourceId: Uint8Array;
+  slot: bigint;
+  root: Uint8Array;
+}
+
+/** Chains whose envelope carries the recent-root references instead of a verifier frame 0. */
+export const ENVELOPE_ROOT_CHAINS: ReadonlySet<bigint> = new Set([1337n]);
+
+/** Whether spends on this chain declare their root in the envelope (see recentRootRefs). */
+export function envelopeRoots(chainId: bigint): boolean {
+  return ENVELOPE_ROOT_CHAINS.has(chainId);
