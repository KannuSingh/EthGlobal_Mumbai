+
+/** The reference a 72-byte EIP-8272 tuple names: source_id, uint64_be(slot), root. */
+export function recentRootRefOf(tuple: Uint8Array): RecentRootRef {
+  if (tuple.length !== 72) throw new RangeError(`a recent-root tuple is 72 bytes, got ${tuple.length}`);
+  return {
+    sourceId: tuple.slice(0, 32),
+    slot: toBigint(tuple.subarray(32, 40)),
+    root: tuple.slice(40, 72),
+  };
+}
+
+/** rlp(recent_root_references), or no bytes when none is declared, as ethrex prices it. */
+export function recentRootCalldata(tx: FrameTx): Uint8Array {
+  const refs = tx.recentRootRefs ?? [];
+  return refs.length === 0 ? new Uint8Array(0) : encodeRefs(refs);
+}
+
+function encodeRefs(refs: readonly RecentRootRef[]): Uint8Array {
+  return rlpList(refs.map((r) => rlpList([rlpBytes(r.sourceId), rlpInt(r.slot), rlpBytes(r.root)])));
+}
+
+/** EIP-8272 reference intrinsic gas: 2,400 for the address plus 2,002 per reference. */
+export function recentRootRefGas(tx: FrameTx): bigint {
+  const count = BigInt(tx.recentRootRefs?.length ?? 0);
+  return count === 0n ? 0n : 2_400n + 2_002n * count;
