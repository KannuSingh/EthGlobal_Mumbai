+/**
+ * The proof frame's execution limit on those chains. msp's 225,000 runs out of gas on that
+ * client (forshtat/ethrex eip8141-tracer); the verifier call is capped at 500,000 inside the
+ * frame anyway, and the dispatcher pins neither. NAINOKOT_VERIFY_GAS overrides it in Node.
+ */
+export const ENVELOPE_VERIFY_FRAME_GAS: bigint = BigInt(
+  (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env
+    ?.NAINOKOT_VERIFY_GAS ?? "450000",
+);
+
 /** The reference a 72-byte EIP-8272 tuple names: source_id, uint64_be(slot), root. */
 export function recentRootRefOf(tuple: Uint8Array): RecentRootRef {
   if (tuple.length !== 72) throw new RangeError(`a recent-root tuple is 72 bytes, got ${tuple.length}`);
